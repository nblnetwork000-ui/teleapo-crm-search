APP_MODE=events
HOST=127.0.0.1
PORT=3000
ALLOW_REMOTE_ACCESS=true
SESSION_SECRET=replace-with-a-long-random-value
# scripts/hash_password.py で作ったハッシュを登録します。
ACCESS_USERS_JSON={"owner@example.com":"pbkdf2_sha256$210000$replace-salt$replace-hash"}

GOOGLE_SHEET_ID=replace-with-sheet-id
GOOGLE_SHEET_NAME=店舗リスト
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-service-account-json

# 任意: Web検索結果もイベント候補へ含める場合
BRAVE_SEARCH_API_KEY=

# 通常版だけで必要
YAHOO_CLIENT_ID=

# 任意
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
